<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#CDD9C4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="207dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Logo"
            android:src="@drawable/logotransparent1" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VitalSmart"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/email"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/roundtextfields"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:textColor="#1B5E20"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/password"
            android:layout_width="291dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/roundtextfields"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="#1B5E20"
            android:textSize="16sp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="195dp"
            android:layout_height="62dp"
            android:backgroundTint="#1B5E20"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/Register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="15sp"
            android:text="No account? Click Here to Register!"
            android:textColor="@android:color/black" />
    </LinearLayout>
</LinearLayout>

