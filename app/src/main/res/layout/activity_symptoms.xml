        android:layout_height="wrap_content"
        android:text="1                     2                     3                     4                     5"
        android:textColor="#1B5E20"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/headacheSeverityBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/hseverityLabels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Mild                                  Moderate                               Severe"
        android:textColor="#1B5E20"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/headacheSeverityLevels"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <CheckBox
