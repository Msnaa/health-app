<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDD9C4"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/homeButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="28dp"
        android:text="Select Your Symptoms"
        android:textColor="#1B5E20"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/homeButton" />

    <CheckBox
        android:id="@+id/fever"
        android:layout_width="126dp"
        android:layout_height="27dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="92dp"
        android:buttonTint="#1B5E20"
        android:text="Fever"
        android:textColor="#1B5E20"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/homeButton" />

    <SeekBar
        android:id="@+id/feverSeverityBar"
        android:layout_width="319dp"
        android:layout_height="26dp"
        android:max="4"
        android:progress="2"
        android:progressTint="#1B5E20"
        android:thumbTint="#1B5E20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fever" />

    <TextView
        android:id="@+id/feverSeverityLevels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1                     2                     3                     4                     5"
        android:textColor="#1B5E20"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/feverSeverityBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/fseverityLabels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Mild                                  Moderate                               Severe"
        android:textColor="#1B5E20"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/feverSeverityLevels"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <CheckBox
        android:id="@+id/cough"
        android:layout_width="145dp"
        android:layout_height="35dp"
        android:layout_marginTop="68dp"
        android:buttonTint="#1B5E20"
        android:text="Cough"
        android:textColor="#1B5E20"
        android:textSize="20sp"
        android:textStyle="bold"
